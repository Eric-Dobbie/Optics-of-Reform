library(ggplot2)
set.seed(30342)
nsims <- 1000
n <- 500
l <- 1
u <- 10
functional_form <- "changes"
fd <- matrix(nrow = nsims, ncol = 3)
mcar <- matrix(nrow = nsims, ncol = 3)
mar <- matrix(nrow = nsims, ncol = 3)
ni <- matrix(nrow = nsims, ncol = 3)
for (i in 1:nsims) {
X <- runif(n, l, u)
X2 <- rnorm(n)
e <- rnorm(n)
if (functional_form == "constant") {
Y <- 5*X + X^2 + X2 + e
}
if (functional_form == "changes") {
Y <- ifelse(X < 4, X^2 + X2, 2*X + X2 +8)
} else {
return("Invalid Functional Form")
}
Xsq <- X^2
#generate missingness
Xmcar <- X
Xmcar[1:n/5] <- NA
Xmcarsq <- Xmcar^2
Xmar <- X
Xmar[X2 <= quantile(X2, probs = 0.2)] <- NA
Xmarsq <- Xmar^2
Xni <- X
Xni[X <= quantile(X, probs = 0.2)] <- NA
Xnisq <- Xni^2
rfd <- lm(Y~X+Xsq+X2)
rmcar <- lm(Y ~ Xmcar + Xmcarsq + X2)
rmar <- lm(Y~Xmar+Xmarsq+X2)
rni <- lm(Y~Xni+Xnisq+X2)
fd[i,1] <- rfd$coefficients[2]
fd[i,2] <- rfd$coefficients[3]
fd[i,3] <- rfd$coefficients[2]+2*rfd$coefficients[3]*mean(X, na.rm = T)
mcar[i,1] <- rmcar$coefficients[2]
mcar[i,2] <- rmcar$coefficients[3]
mcar[i,3] <- rmcar$coefficients[2]+2*rmcar$coefficients[3]*mean(X, na.rm = T)
mar[i,1] <- rmar$coefficients[2]
mar[i,2] <- rmar$coefficients[3]
mar[i,3] <- rmar$coefficients[2]+ 2*rmar$coefficients[3]*mean(X, na.rm = T)
ni[i,1] <- rni$coefficients[2]
ni[i,2] <- rni$coefficients[3]
ni[i,3] <- rni$coefficients[2]+2*rni$coefficients[3]*mean(X, na.rm = T)
}
fd <- as.data.frame(fd)
colnames(fd) <- c("B1", "B2", "MS")
fd$group <- "Full Data"
mcar <- as.data.frame(mcar)
colnames(mcar) <-  c("B1", "B2", "MS")
mcar$group <- "MCAR"
