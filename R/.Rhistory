library(ggplot2)
set.seed(30342)
nsims <- 1000
n <- 500
l <- 1
u <- 10
functional_form <- "changes"
fd <- matrix(nrow = nsims, ncol = 3)
mcar <- matrix(nrow = nsims, ncol = 3)
mar <- matrix(nrow = nsims, ncol = 3)
ni <- matrix(nrow = nsims, ncol = 3)
for (i in 1:nsims) {
X <- runif(n, l, u)
X2 <- rnorm(n)
e <- rnorm(n)
if (functional_form == "constant") {
Y <- 5*X + X^2 + X2 + e
}
if (functional_form == "changes") {
Y <- ifelse(X > 4, 5*X + X^2 + e + X2, 9*X + X2)
} else {
return("Invalid Functional Form")
}
Xsq <- X^2
#generate missingness
Xmcar <- X
Xmcar[1:n/5] <- NA
Xmcarsq <- Xmcar^2
Xmar <- X
Xmar[X2 <= quantile(X2, probs = 0.2)] <- NA
Xmarsq <- Xmar^2
Xni <- X
Xni[X <= quantile(X, probs = 0.2)] <- NA
Xnisq <- Xni^2
rfd <- lm(Y~X+Xsq+X2)
rmcar <- lm(Y ~ Xmcar + Xmcarsq + X2)
rmar <- lm(Y~Xmar+Xmarsq+X2)
rni <- lm(Y~Xni+Xnisq+X2)
fd[i,1] <- rfd$coefficients[2]
fd[i,2] <- rfd$coefficients[3]
fd[i,3] <- rfd$coefficients[2]+2*rfd$coefficients[3]*mean(X, na.rm = T)
mcar[i,1] <- rmcar$coefficients[2]
mcar[i,2] <- rmcar$coefficients[3]
mcar[i,3] <- rmcar$coefficients[2]+2*rmcar$coefficients[3]*mean(X, na.rm = T)
mar[i,1] <- rmar$coefficients[2]
mar[i,2] <- rmar$coefficients[3]
mar[i,3] <- rmar$coefficients[2]+ 2*rmar$coefficients[3]*mean(X, na.rm = T)
ni[i,1] <- rni$coefficients[2]
ni[i,2] <- rni$coefficients[3]
ni[i,3] <- rni$coefficients[2]+2*rni$coefficients[3]*mean(X, na.rm = T)
}
fd <- as.data.frame(fd)
colnames(fd) <- c("B1", "B2", "MS")
fd$group <- "Full Data"
mcar <- as.data.frame(mcar)
colnames(mcar) <-  c("B1", "B2", "MS")
mcar$group <- "MCAR"
mar <- as.data.frame(mar)
colnames(mar) <-  c("B1", "B2", "MS")
mar$group <- "MAR"
ni <- as.data.frame(ni)
colnames(ni) <-  c("B1", "B2", "MS")
ni$group <- "NI"
df <- rbind(fd, mcar, mar, ni)
ggplot() +
geom_point(aes(x = X, y = Y), position = position_jitter(width = 0.2, height = 0)) +
geom_smooth(aes(x = X, y =ifelse(X > 4, 5*X + X^2 + X2, 9*X)), method = "loess", se = FALSE) +
geom_smooth(aes(x = X, y = rfd$coefficients[1] + rfd$coefficients[2] * X + rfd$coefficients[3] * X^2, color = "red", linetype = "dashed"), method = "loess")
ggplot() +
geom_point(aes(x = Xmcar, y = Y), position = position_jitter(width = 0.2, height = 0)) +
geom_smooth(aes(x = X, y =ifelse(X > 4, 5*X + X^2 + X2, 9*X)), method = "loess", se = FALSE) +
geom_smooth(aes(x = X, y = rmcar$coefficients[1] + rmcar$coefficients[2] * X + rmcar$coefficients[3] * X^2, color = "red", linetype = "dashed"), method = "loess")
ggplot() +
geom_point(aes(x = Xmar, y = Y), position = position_jitter(width = 0.2, height = 0)) +
geom_smooth(aes(x = X, y =ifelse(X > 4, 5*X + X^2 + X2, 9*X)), method = "loess", se = FALSE) +
geom_smooth(aes(x = X, y = rmar$coefficients[1] + rmar$coefficients[2] * X + rmar$coefficients[3] * X^2, color = "red"), method = "loess")
ggplot() +
geom_point(aes(x = Xni, y = Y), position = position_jitter(width = 0.2, height = 0)) +
geom_smooth(aes(x = X, ifelse(X > 4, 5*X + X^2 + X2, 9*X)), method = "loess", se = FALSE) +
geom_smooth(aes(x = X, y = rni$coefficients[1] + rni$coefficients[2] * X + rni$coefficients[3] * X^2, color = "red"), method = "loess")
ggplot(df) +
geom_histogram(aes(x = B1, fill = group), color = "black")
ggplot(df) +
